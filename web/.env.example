VITE_API_BASE_URL=http://localhost:8000/api

# Where the legacy substation documents (SLD PDFs, site photos) are served
# from. The database stores only filenames like "2513link_sld.pdf"; the old
# IIS site served them from Upload/links/. Point this at wherever those files
# now live - a copied folder, a share, or the old server.
VITE_DOCUMENT_BASE_URL=/documents
