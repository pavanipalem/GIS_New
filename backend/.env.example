# Copy to .env and fill in real values. .env is git-ignored.

# --- Database ---
# App connects to the `gis` schema. `legacy_raw` stays read-only / archival.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@172.17.4.194:5432/gisdata
DB_SCHEMA=gis
LEGACY_SCHEMA=legacy_raw

# --- Auth / JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# --- App ---
ENV=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- First admin (created by `python -m app.cli seed-admin` if no admin exists) ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=CHANGE_ME
